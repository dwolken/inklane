<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Inklane</AssemblyName>
    <RootNamespace>Inklane</RootNamespace>
    <Version>1.0.0-rc.2</Version>
    <Product>Inklane</Product>
    <Company>Inklane</Company>
    <Description>Local image annotation and PDF notebooks</Description>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/inklane.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/inklane.ico" />
    <ProjectReference Include="../Inklane.Core/Inklane.Core.csproj" />
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop" Value="true" />
  </ItemGroup>
</Project>
