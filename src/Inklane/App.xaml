<Application x:Class="Inklane.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 ThemeMode="System">
 <Application.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}"><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="MinHeight" Value="34"/><Setter Property="MinWidth" Value="90"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,5"/></Style>
  <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}"><Setter Property="MaxWidth" Value="320"/></Style>
 </Application.Resources>
</Application>
